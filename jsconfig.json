{
  "compilerOptions": { "allowJs": true, "checkJs": true, "noEmit": true, "strict": true,
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "resolveJsonModule": true,
    "esModuleInterop": true, "skipLibCheck": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"] },
  "include": ["src/**/*.js", "desktop/**/*.cjs", "tools/**/*.mjs", "*.js"]
}
